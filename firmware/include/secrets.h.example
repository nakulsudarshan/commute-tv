// Copy to secrets.h and fill in. secrets.h is gitignored.
//
//     cp include/secrets.h.example include/secrets.h
//
// ⚠️ These are your DORM/UNIVERSITY ACCOUNT credentials when using Campus-WLAN.
// NVS is not encrypted by default, so anyone holding the board can read them
// off the flash. This is also a contractual point now: clause 6.f of the AVV
// agreement requires access credentials to be protected from third parties.
// Ask dorm IT for a device-specific credential if they will give you one.
//
// This file exists for BRING-UP. The finished firmware reads all of this from
// NVS via the web config UI, so a credential change costs a settings edit
// rather than a reflash.
#pragma once

// --- WiFi ------------------------------------------------------------------
// A LIST, in YOUR order of preference. One line per network:
//
//     { ssid, password, eapIdentity, eapUsername, eapPassword, minRssi }
//
//   * Ordinary network (WPA2-PSK): set ssid + password, leave the three EAP
//     fields as "".
//   * Enterprise (802.1X, e.g. Campus-WLAN): set ssid + eapUsername +
//     eapPassword, leave password as "". eapIdentity is the outer/anonymous
//     one -- leave it "" and the username is used, which is right for most
//     university setups.
//   * minRssi is how weak this network may get before the NEXT one down the
//     list is preferred instead. It does not stop it being used when it is all
//     there is.
//
//     THIS IS A REAL CHOICE, so make it deliberately:
//       -80  "use the dorm while it is decent, otherwise my hotspot"  <- sane
//       -95  "always the dorm, however bad, unless it is completely gone"
//     Measured at the desk: Campus ranges -75 to -91 depending on where the
//     board sits, and the hotspot reads -24. At -95 the dorm wins every time,
//     including at -88 with a comfortable hotspot in the room. The boot log
//     says when priority passed over something much louder, so you can see the
//     effect of whatever you pick.
//
// Order is yours. The board surveys the air at boot and prints every network in
// this list with its measured signal and the choice it made, so if it picks
// something you did not expect, the serial log says why.
//
// Adding another network is one more line -- put it above or below the
// others depending on which you want preferred where both are audible.
#define WIFI_NETWORK_LIST                                                     \
    { "Campus-WLAN", "", "", "your-username", "your-account-password", -80 },          \
    { "Phone Hotspot",   "your-hotspot-password", "", "", "", -85 },        \
    { "Flat-WLAN",  "flat-password",         "", "", "", -85 },

// --- SmallTV ----------------------------------------------------------------
// The SmallTV NEVER joins the dorm network: its /update endpoint is
// unauthenticated, so on a shared network any resident could reflash it. The
// ESP32 runs its own access point instead -- hidden, WPA2, max_connection = 1,
// so the radio physically refuses a second client -- and the SmallTV is its only
// ever guest.
//
// Pick a long random passphrase; you type it into the SmallTV once and never
// again. `openssl rand -base64 24` is a fine way to get one.
//
// ⚠️ One radio means the AP and the station share a channel. When the dorm link
// moves channel, this AP moves with it and the SmallTV drops and re-associates
// on its own. A few seconds, not a failure -- but it is why a frame may briefly
// go stale, and it is not a bug when you see it.
#define SMALLTV_AP_SSID    "commute-link"
#define SMALLTV_AP_PASS    "change-me-to-something-long-and-random"

// Where the SmallTV ends up on that AP. Left here as a fallback only: the
// firmware asks its own DHCP table for the address of whatever associated,
// rather than assuming the first lease.
#define SMALLTV_HOST_FALLBACK "192.168.4.2"
