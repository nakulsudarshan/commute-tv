# --- Secrets. Nothing here may ever reach a remote. -------------------------
#
# Every one of these is generated from .env by a tool in tools/. If you lose
# one, regenerate it; never restore it from a commit, because it should never
# have been in one.
.env
*.env
!.env.example

# Google service-account key: contains an RSA PRIVATE KEY.
service-account*.json
*-service-account*.json
oauth-client*.json
client_secret*.json
*.key.json

# WiFi credentials (often your university account) and the SmallTV AP
# passphrase, typed in by hand.
firmware/include/secrets.h

# Generated by tools/gen_secrets.py. CONTAINS THE RSA PRIVATE KEY in C form,
# plus the transit access id and the openrouteservice key.
firmware/include/secrets_generated.h

# Root certificates are themselves public, but this file is generated for the
# specific endpoints you use, which may include a transit API whose technical
# details your agreement treats as confidential. Regenerate it with
# tools/fetch_root_ca.py rather than committing it.
firmware/include/root_ca.h

# --- Build output ------------------------------------------------------------
build/
firmware/.pio/
tools/__pycache__/
__pycache__/
*.pyc

# Regenerated by `make preview` and `make oled`. The curated stills that the
# README links to live in docs/images/ and ARE committed.
preview/out/

# Recorded upstream API responses. Useful locally; check your provider's terms
# before committing any.
fixtures/*.json
!fixtures/README.md

.DS_Store
