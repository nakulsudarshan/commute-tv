# Copy to .env and fill in. .env is gitignored -- never commit real keys.
#
#   cp .env.example .env

# AVV HAFAS ReST. From the AVV email; the demo and production systems share
# the same key. Starts with xxxxxxxx-
AVV_ACCESS_ID=

# demo | prod   (develop against demo; AVV asked for this explicitly)
AVV_ENV=demo

# openrouteservice -- free signup at https://openrouteservice.org
ORS_API_KEY=

# Home location, decimal degrees. Google Maps: right-click -> click the
# coordinates to copy.
HOME_LAT=
HOME_LON=

# --- Frequent destinations -----------------------------------------------
#
# Optional, and only a shortcut. The normal path is that a calendar event's
# `location` string is resolved through the AVV location service. These entries
# short-circuit that for the places you go often: an exact match on the label
# skips the lookup, which saves an API call per appointment and, more usefully,
# removes the chance of the lookup picking the wrong Ponttor.
#
# Format: LABEL|LAT|LON.
#
# The label is compared against WHAT YOU TYPE in a calendar event's location
# field -- not against Google Maps, not against the nearest stop's official
# name. Use whatever you would actually write.
#
# Matching ignores case, spacing and punctuation, tolerates a trailing address,
# and treats the German digraphs as equal, so all of these find "SuperC":
#
#     SuperC / superc / Super C / SuperC, Templergraben 57, 52062 Aachen
#
# and "RWTH Hauptgebaude" is found by "Hauptgebäude" and "Hauptgebaeude" too.
# Matching is whole-word, so "Supercomputer Centre" does NOT match "SuperC".
#
# Examples -- replace with your own:
#   DEST_1=Gym|50.770770|6.118744
#   DEST_2=Central Station|50.768105|6.091202
#
# Run `python3 tools/resolve_places.py` to check AVV can plan a journey to each.

# --- Request budget -------------------------------------------------------
#
# The AVV usage agreement names no rate limit, but clause 3.a requires live
# queries only and clause 6.a requires technical measures against mass
# retrieval. These are those measures. Normal operation uses a few hundred
# requests a day at most, so these are a fuse, not a throttle: they exist to
# stop a runaway loop before AVV notices it.
AVV_MIN_INTERVAL_SEC=20
AVV_MAX_PER_HOUR=60
AVV_MAX_PER_DAY=500

# Google Calendar, via a service account (no OAuth, no token that expires).
# The JSON key is a PRIVATE KEY: keep it out of git -- the root .gitignore
# already covers service-account*.json.
GOOGLE_SA_KEY_PATH=../service-account.json

# The calendar the device reads. Granting a service account access to a calendar
# you own does not work on a consumer Google account (see memory.md), so the
# service account owns this one and shares it with you. tools/make_sa_calendar.py
# creates it and prints the id to paste here -- it looks like
# ...@group.calendar.google.com
GOOGLE_CALENDAR_ID=

# Your own address, so the tools can re-share the calendar if you ever remove it
# from your sidebar.
GOOGLE_OWNER_EMAIL=

# One-time only, for tools/grant_calendar_access.py. The Calendar web UI does
# not reliably persist a share to a service account, so the permission is
# written through the API instead. A "Desktop app" OAuth client from the same
# project. Not used by the firmware, and not needed again afterwards.
GOOGLE_OAUTH_CLIENT_PATH=../oauth-client.json

# Dorm WiFi. Campus-WLAN is WPA2-Enterprise (802.1X), so a registered MAC is not
# enough -- the device must authenticate with your credentials.
#
# ⚠️ These are almost certainly your DORM/UNIVERSITY ACCOUNT credentials. Think
# before writing them here or flashing them to a device: see memory.md §2a. This
# file is gitignored, but the ESP32 stores them in NVS, which is readable from
# an unencrypted flash chip by anyone holding the board.
WIFI_SSID=Campus-WLAN
WIFI_EAP_IDENTITY=
WIFI_EAP_USERNAME=
WIFI_EAP_PASSWORD=

# SmallTV address. Over its own GIFTV hotspot this is 192.168.4.1; once it is
# attached to the ESP32's private AP the ESP32 assigns it a fixed address.
SMALLTV_HOST=192.168.4.1
